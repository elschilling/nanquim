{
  "name": "nanquim",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "packageManager": "pnpm@8.15.5",
  "engines": {
    "node": "^22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "pnpm test:browser:chromium",
    "test:browser:chromium": "pnpm build && node scripts/browser/run-workflows.mjs --browser=chromium",
    "test:browser:firefox": "pnpm build && node scripts/browser/run-workflows.mjs --browser=firefox",
    "qualify:interoperability": "node scripts/qualification/run-interoperability.mjs",
    "test:performance": "pnpm build && node scripts/performance/run-benchmarks.mjs --browser=chromium",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "@vue/language-plugin-pug": "^1.8.27",
    "jsdom": "^30.0.1",
    "puppeteer-core": "^25.8.0",
    "sass": "^1.102.0",
    "vite": "^6.4.3",
    "vite-plugin-pug": "^0.4.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@svgdotjs/svg.js": "^3.2.5",
    "jspdf": "^4.2.1",
    "lodash": "^4.18.1",
    "rbush": "^4.0.1",
    "svg2pdf.js": "^2.7.0",
    "vecks": "^3.9.2"
  },
  "pnpm": {
    "overrides": {
      "dompurify@<=3.4.12": "3.4.13",
      "nanoid@<3.3.18": "3.3.18"
    }
  }
}
