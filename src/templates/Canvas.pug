.editor.canvas-editor
  .editor-header
    .wgt.wgt-menu.editor-mode-menu(onclick='toggleEditorModeMenu(event)')
        span.icon.icon-mode-draw#editor-mode-icon
        span.editor-mode-label#editor-mode-label Draw Space
        .icon.icon-dropdown
        .dropdown-menu.editor-mode-dropdown#editor-mode-dropdown
          .menu-item.editor-mode-item(data-mode='model' onclick='switchEditorMode("model")')
            span.icon.icon-mode-draw
            | Draw Space
          .menu-item.editor-mode-item(data-mode='paper' onclick='switchEditorMode("paper")')
            span.icon.icon-mode-paper
            | Paper Space
    .align-buttons-center
      .wgt.wgt-menu
        button.icon.icon-orthomode.toolbar-icon-button#ortho-toggle(type='button' title='Ortho (F8)' aria-label='Ortho' aria-keyshortcuts='F8' aria-pressed='false' onclick='handleToogleOrtho()')
        button.icon.icon-snap-off.toolbar-icon-button#object-snap-toggle(type='button' title='Object Snap (F9)' aria-label='Object Snap' aria-keyshortcuts='F9' aria-pressed='false' onclick='handleToogleSnap()')
      .wgt.wgt-menu
        button.toolbar-icon-button.toolbar-composite-button#snap-options-button(type='button' title='Object Snap settings' aria-label='Object Snap settings' aria-haspopup='dialog' aria-controls='snap-options-menu' aria-expanded='false' onclick='toggleSnapMenu(event)')
          span.icon.icon-snap-options(aria-hidden='true')
          span.icon.icon-dropdown(aria-hidden='true')
        .snap-options-menu#snap-options-menu(role='dialog' aria-label='Object Snap options' aria-hidden='true')
          label.snap-menu-item
            input.snap-checkbox(type='checkbox' data-snap='endpoint' checked onchange='handleSnapTypeChange(this)')
            | Endpoint
          label.snap-menu-item
            input.snap-checkbox(type='checkbox' data-snap='midpoint' checked onchange='handleSnapTypeChange(this)')
            | Midpoint
          label.snap-menu-item
            input.snap-checkbox(type='checkbox' data-snap='center' checked onchange='handleSnapTypeChange(this)')
            | Center
          label.snap-menu-item
            input.snap-checkbox(type='checkbox' data-snap='quadrant' checked onchange='handleSnapTypeChange(this)')
            | Quadrant
          label.snap-menu-item
            input.snap-checkbox(type='checkbox' data-snap='intersection' onchange='handleSnapTypeChange(this)')
            | Intersection
          label.snap-menu-item
            input.snap-checkbox(type='checkbox' data-snap='extension' onchange='handleSnapTypeChange(this)')
            | Extension
          label.snap-menu-item
            input.snap-checkbox(type='checkbox' data-snap='perpendicular' onchange='handleSnapTypeChange(this)')
            | Perpendicular
          label.snap-menu-item
            input.snap-checkbox(type='checkbox' data-snap='tangent' onchange='handleSnapTypeChange(this)')
            | Tangent
          label.snap-menu-item
            input.snap-checkbox(type='checkbox' data-snap='nearest' onchange='handleSnapTypeChange(this)')
            | Nearest
          label.snap-menu-item
            input.snap-checkbox(type='checkbox' data-snap='grid' onchange='handleGridSnapChange(this)')
            | Grid snap
          .snap-menu-divider
          label.snap-menu-item
            input.snap-checkbox(type='checkbox' checked onchange='handleSnapExcludeNonSelectableChange(this)')
            | Exclude non-selectable
      .wgt.wgt-menu
        button.icon.icon-polartrack.toolbar-icon-button#polar-tracking-toggle(type='button' title='Polar Tracking (F10)' aria-label='Polar Tracking' aria-keyshortcuts='F10' aria-pressed='false' onclick='handleTogglePolarTracking()')
    .wgt.wgt-menu.align-buttons-right
      .icon.icon-overlay.is-active(onclick='handleToogleOverlay()')
      .icon.icon-dropdown(onclick='toggleOverlayMenu(event)')
      .overlay-menu#overlay-menu
        label.overlay-menu-item
          input.overlay-checkbox(type='checkbox' data-overlay='grid' checked onchange='handleToggleGrid(this.checked)')
          | Grid
        label.overlay-menu-item
          input.overlay-checkbox(type='checkbox' checked onchange='handleToggleAxis(this.checked)')
          | Axis
        label.overlay-menu-item
          input.overlay-checkbox(type='checkbox' onchange='handleToggleNonScalingStroke(this.checked)')
          | Non-scaling stroke

  .layout-editor#canvas
    include Terminal
