section.web-section
  button.navbar-welcome-button#navbar-welcome-open(type='button' title='Open welcome screen' aria-label='Open welcome screen' aria-haspopup='dialog' aria-controls='ws-dialog')
    span.icon.icon-nanquim-logo(aria-hidden='true')
  ul
    li
      a.navbar-menus(onclick='menuFile()') File
      .dropdown-menu
        ul
          li(onclick='newDocument()')
            | New
          li(onclick='openSVG()')
            | Open…
          li(onclick='saveSVG()')
            | Save
          li(onclick='saveAsSVG()')
            | Save As…
          li(onclick='exportSVG()')
            | Export SVG
          li(onclick='saveDXF()')
            | Export DXF
    li
      a(onclick='openPreferences()') Preferences
    li
      button.navbar-help-button#command-tool-palette-toggle(type='button' title='Toggle command tools (F4)' aria-label='Toggle command tools' aria-controls='command-tool-palette' aria-expanded='true' aria-keyshortcuts='F4') Tools
    li
      button.navbar-help-button#command-help-open(type="button" aria-haspopup="dialog" aria-controls="command-help-dialog" aria-keyshortcuts="F1") Help
